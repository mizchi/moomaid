supported_targets = "js+wasm"

import {
  "mizchi/syntree/highlight",
  "mizchi/crater-layout" @crater,
  "mizchi/crater-core" @layout_types,
  "mizchi/css/values" @types,
  "mizchi/css/style",
  "mizchi/crater-core/node",
}

options(
  link: {
    "js": {
      "exports": [
        "parse",
        "render_to_string",
        "experimental_render_to_svg",
        "svg_options_from_theme",
      ],
      "format": "esm",
    },
  },
)
