///| Standalone prototype for the Mooncakes skill command contract.
///|
///| Run with:
///| `moon run --target wasm examples/moomaid.mbtx --format ascii < diagram.mmd`
import {
  "mizchi/moomaid@0.3.1" @mermaid,
  "moonbitlang/core/env",
  "moonbitlang/x@0.4.47/fs",
}

///|
enum OutputFormat {
  Ascii
  Svg
}

///|
fn print_usage() -> Unit {
  println("Usage: moomaid.mbtx [--format ascii|svg] < Mermaid.mmd")
}

///|
fn parse_format(args : Array[String]) -> OutputFormat? {
  if args.length() == 1 {
    Some(Ascii)
  } else if args.length() == 3 && args[1] == "--format" {
    match args[2] {
      "ascii" => Some(Ascii)
      "svg" => Some(Svg)
      _ => None
    }
  } else {
    None
  }
}

///|
fn main {
  match parse_format(@env.args()) {
    None => print_usage()
    Some(format) => {
      let source = @fs.read_file_to_string("/dev/stdin") catch {
        @fs.IOError(message) => {
          println("moomaid: unable to read standard input: " + message)
          return
        }
      }
      let output = match format {
        Ascii => @mermaid.render_to_string(source)
        Svg => @mermaid.experimental_render_to_svg(source)
      }
      println(output)
    }
  }
}
