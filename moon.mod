name = "mizchi/moomaid"

version = "0.4.0"

import {
  "moonbitlang/async@0.20.3",
  "mizchi/syntree@0.2.3",
  "mizchi/tui@0.10.0",
  "mizchi/signals@0.6.5",
  "moonbitlang/x@0.4.47",
  "mizchi/svg@0.2.1",
  "mizchi/font@0.7.3",
  "mizchi/crater-layout@0.19.0",
  "mizchi/crater-core@0.19.0",
  "mizchi/css@0.7.3",
}

readme = "README.mbt.md"

repository = "https://github.com/mizchi/moomaid"

license = "Apache-2.0"

keywords = [ "mermaid", "diagram", "ascii", "svg", "flowchart", "sequence" ]

description = "Mermaid diagram renderer for MoonBit (ASCII and SVG output)"

source = "src"

preferred_target = "js"
